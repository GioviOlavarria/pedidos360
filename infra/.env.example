# Copiar a infra/.env y completar. NUNCA commitear infra/.env.

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=cambia-esta-clave-root
DB_USER=pedidos360user
DB_PASSWORD=cambia-esta-clave

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
# App Registration del frontend (SPA)
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# App Registration de la API (expone el scope access_as_user). Los tokens deben tener aud = este id.
API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Roles ─────────────────────────────────────────────────────────────────────
# Correos (separados por coma) que entran como Administrador. Cualquier otra cuenta es Cliente.
ADMIN_EMAILS=gi.olavarria@duocuc.cl
# Opcional (recomendado): tenant desde el que debe venir el Admin. La cuenta de Duoc entra como
# invitada de nuestro tenant, así que aquí iría AZURE_AD_TENANT_ID.
ADMIN_TENANT_ID=

# ── Comunicación interna orders -> catalog ────────────────────────────────────
INTERNAL_API_KEY=cambia-esta-clave-interna-larga

# ── RabbitMQ (cluster de 3 nodos) ─────────────────────────────────────────────
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=cambia-esta-clave-rabbit
RABBITMQ_ERLANG_COOKIE=cambia-esta-cookie-erlang

# ── Correo de boletas ─────────────────────────────────────────────────────────
# Por defecto se usa MailHog (bandeja de pruebas en http://localhost:8025).
# Ejemplo Gmail (requiere "contraseña de aplicación" con verificación en 2 pasos):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu.cuenta@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=Pedidos360 <tu.cuenta@gmail.com>

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_BFF_URL=http://localhost:8080
