# Copiar a infra/.env y completar. NUNCA commitear infra/.env.

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Sin DB_URL se usa el contenedor mysql del compose. Base de datos CLOUD (Aiven MySQL, plan Free): host, puerto,
# usuario y contraseña en console.aiven.io → servicio → Overview → Connection information. Conexión con TLS:
# DB_URL=jdbc:mysql://<servicio>-<proyecto>.h.aivencloud.com:<puerto>/pedidos360_db?sslMode=REQUIRED&serverTimezone=UTC
# DB_USER=avnadmin
# DB_PASSWORD=<contraseña de Aiven>
DB_ROOT_PASSWORD=cambia-esta-clave-root
DB_USER=pedidos360user
DB_PASSWORD=cambia-esta-clave

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
# App Registration del frontend (SPA)
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# App Registration de la API (expone el scope access_as_user). Los tokens deben tener aud = este id.
API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Roles ─────────────────────────────────────────────────────────────────────
# Correos (separados por coma) que entran como Administrador. Cualquier otra cuenta es Cliente.
ADMIN_EMAILS=gi.olavarria@duocuc.cl
# Opcional (recomendado): tenant desde el que debe venir el Admin. La cuenta de Duoc entra como
# invitada de nuestro tenant, así que aquí iría AZURE_AD_TENANT_ID.
ADMIN_TENANT_ID=

# ── Comunicación interna orders -> catalog ────────────────────────────────────
INTERNAL_API_KEY=cambia-esta-clave-interna-larga

# ── RabbitMQ (cluster de 3 nodos) ─────────────────────────────────────────────
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=cambia-esta-clave-rabbit
RABBITMQ_ERLANG_COOKIE=cambia-esta-cookie-erlang

# ── Correo de boletas ─────────────────────────────────────────────────────────
# Por defecto se usa MailHog (bandeja de pruebas en http://localhost:8025).
# Ejemplo Gmail (requiere "contraseña de aplicación" con verificación en 2 pasos):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu.cuenta@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=Pedidos360 <tu.cuenta@gmail.com>

# ── Frontend (Angular) ────────────────────────────────────────────────────────
# URL del BFF que usa el navegador (se incrusta en el bundle al compilar).
BFF_URL=http://localhost:8080

# ── Kafka (opcional: valores por defecto) ─────────────────────────────────────
# Puertos publicados solo en 127.0.0.1: Kafka UI y API de administración de Kafka.
# KAFKA_UI_PORT=8085
# KAFKA_ADMIN_PORT=8084

# ── Boleta electrónica SII ────────────────────────────────────────────────────
# simulado: calcula neto/IVA y genera folio, timbre y track ID sin conectarse al SII.
SII_MODE=simulado
SII_RUT_EMISOR=76123456-7

# ── Pagos (ms-pedidos360-payments) ────────────────────────────────────────────
# simulado: pasarela de prueba local (sin cuenta). flow: API de Flow con las credenciales de abajo.
PAYMENT_PROVIDER=simulado
# Credenciales de Flow: sandbox.flow.cl (pruebas) o www.flow.cl (producción) → Mis datos → Seguridad.
# FLOW_API_URL=https://sandbox.flow.cl/api
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# URL pública del BFF para la confirmación servidor a servidor de Flow (p. ej. túnel ngrok al puerto 8080).
# PAYMENTS_PUBLIC_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:3000
# Minutos para pagar antes de cancelar el pedido y devolver el stock (orders).
# PAYMENT_EXPIRATION=PT30M
