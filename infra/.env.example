# .env.example — infra/
# Copiar como .env y completar todos los valores antes de ejecutar docker compose.
# Este archivo SÍ se commitea (sin valores reales). El .env NO.

# ── Base de datos (AWS RDS) ───────────────────────────────────────────────────
# URL de conexión a la base de datos externa (ej. AWS RDS)
DB_URL=jdbc:mysql://<tu-endpoint-rds>.eu-west-1.rds.amazonaws.com:3306/pedidos360_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Usuario y contraseña de la BD
DB_USER=admin
DB_PASSWORD=cambia_esta_password_aws

# ── Azure AD ──────────────────────────────────────────────────────────────────
# ID del tenant de Azure AD
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# App Registration del frontend (y del BFF como resource server)
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# App Registration de la API/BFF expuesto como scope access_as_user
API_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URI del emisor JWT de Azure AD (usado por los microservicios para validar tokens)
# Formato: https://login.microsoftonline.com/<AZURE_AD_TENANT_ID>/v2.0
JWT_ISSUER_URI=https://login.microsoftonline.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/v2.0

# ── Frontend (build args de Vite) ────────────────────────────────────────────
# URL pública del BFF accesible desde el navegador del usuario final.
# En Docker local apunta al puerto mapeado del contenedor bff.
VITE_BFF_URL=http://localhost:8080
