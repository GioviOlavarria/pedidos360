# Plantilla de variables de entorno para frontend-pedidos360.
# Copiar este archivo como .env.local y completar los valores reales.
# .env.local está en .gitignore y NUNCA debe commitearse.

# URL base del BFF (ms-pedidos360-bff, puerto 8080)
VITE_BFF_URL=http://localhost:8080

# App Registration del frontend en Azure AD
VITE_AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID del tenant de Azure AD
VITE_AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# App Registration de la API/BFF (para el scope access_as_user)
VITE_API_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
