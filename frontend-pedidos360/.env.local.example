# Variables de entorno para desarrollo local
# Renombrar este archivo a .env.local y completar los valores reales.
# NUNCA commitear .env.local al repositorio.

# App Registration del frontend (frontend-pedidos360)
VITE_AZURE_AD_CLIENT_ID=reemplazar-con-client-id-del-frontend

# Tenant de Azure AD
VITE_AZURE_AD_TENANT_ID=reemplazar-con-tenant-id

# App Registration del BFF/API (scope access_as_user)
VITE_API_CLIENT_ID=reemplazar-con-client-id-de-la-api

# URL base del BFF (ms-pedidos360-bff)
VITE_BFF_URL=http://localhost:8080
