# Variables de entorno para desarrollo local (npm start).
# Copiar a .env.local y completar. NUNCA commitear .env.local.
# scripts/set-env.mjs las incrusta en src/environments/environment.ts al compilar.

# App Registration del frontend
AZURE_AD_CLIENT_ID=reemplazar-con-client-id-del-frontend

# Tenant de Azure AD
AZURE_AD_TENANT_ID=reemplazar-con-tenant-id

# App Registration del BFF/API (scope access_as_user)
API_CLIENT_ID=reemplazar-con-client-id-de-la-api

# URL base del BFF (ms-pedidos360-bff)
BFF_URL=http://localhost:8080

# Correos con rol Administrador (solo decide qué pantallas se muestran; el backend vuelve a validar)
ADMIN_EMAILS=gi.olavarria@duocuc.cl
